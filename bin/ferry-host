#!/usr/bin/env bash
# ferry-host: manages the one long-lived ferry nvim server and the
# note in it. Every call goes through `nvim --server <sock> --remote-expr`;
# the server side is lua/ferry/note.lua.
#
# Usage: ferry-host ensure|show|talk|release|flow-state|draft|attach-cmd|status|stop
#   ensure                          start the server unless one answers, and
#                                   load the note module into it
#   show [--talk] <target> <window> [seed]
#                                   resume the unfinished note, or open a
#                                   fresh one (always fresh with a seed file),
#                                   in insert mode; prints the note's path.
#                                   --talk: Flow was started (hold to talk),
#                                   so the note treats it as recording
#   talk                            hold to talk in the note already shown:
#                                   insert at the cursor, Flow recording;
#                                   prints `talk <path>` or `no note`
#   release [--force]               stop Flow and wait for its paste into the
#                                   note; prints `released` or `idle`
#                                   (--force: stop even when nvim knows of no
#                                   recording, prints `forced`)
#   flow-state                      print `recording`, `waiting`, `stopped`
#                                   (the talk key's recording ended by
#                                   nvim's stop, its paste arrived) or `idle`
#   draft                           save the note's file and set
#                                   g:ferry_draft; prints its path
#   attach-cmd                      print the command a UI runs to attach
#   status                          print `up uis=N` or `down`
#   stop                            quit the server and remove the socket
#
# Environment:
#   FERRY_SOCK              socket (default ${TMPDIR}/ferry.sock)
#   FERRY_NOTES_DIR         notes folder, one markdown file per note
#                           (default ~/notes/scratchpads)
#   FERRY_OUTBOX            submit files for Hammerspoon, read by the server
#                           (default ${TMPDIR}/ferry-outbox)
#   FERRY_INDEX             notes search index, read by the server through
#                           bin/ferry-notes (default in ~/Library/Application
#                           Support/ferry)
#   FERRY_HOST_NVIM_FLAGS   extra flags for the server nvim (tests: --clean)
#   FERRY_SIDEBAR           0: show opens the note without the history sidebar
#   FERRY_GUI_FONT          Neovide font (e.g. "Menlo:h14"); default: Ghostty's
#   FERRY_GUI_BG            Neovide background when the colorscheme has none
#                               (e.g. "#001e27"); default: Ghostty's
#
# GUI settings (font, background) are read from `ghostty +show-config` by
# ensure, and by show when the server has none yet (a server started before
# they existed). They only take effect while Neovide is attached
# (lua/ferry/gui.lua). No Ghostty: no GUI settings, nothing else changes.
set -u

# Called from Hammerspoon we inherit a bare launchd PATH, so make sure
# Homebrew and user bins are reachable for nvim.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:/usr/local/bin:$PATH"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(dirname "$here")
tmp=${TMPDIR:-/tmp}; tmp=${tmp%/}
sock=${FERRY_SOCK:-$tmp/ferry.sock}
notes=${FERRY_NOTES_DIR:-$HOME/notes/scratchpads}
nvim_bin=$(command -v nvim) || { echo "ferry-host: nvim not found" >&2; exit 1; }

# Quote a string as a Vim script literal.
vimstr() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }

rexpr() { "$nvim_bin" --server "$sock" --remote-expr "$1"; }

# Quote a string as a Lua literal inside a Vim '...' string (luaeval).
luastr() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\'/\'\'}; printf '"%s"' "$s"; }

# Lua statement: prepend the repo to the runtimepath when it is missing.
# Plugin managers (lazy.nvim) reset rtp during startup, dropping the
# `--cmd 'set rtp^=<repo>'` entry, so every call that requires a ferry
# module runs this first, in the same round trip.
rtp_fix="local ferryr = $(luastr "$root"); if not vim.tbl_contains(vim.opt.rtp:get(), ferryr) then vim.opt.rtp:prepend(ferryr) end"

# The note module, as a Lua expression (repo put on rtp first). A server
# started before the module last changed (note.api differs) reloads it,
# keeping its state and host.
note_api=12
note_mod="(function(want) $rtp_fix; local n = require(\"ferry.note\"); if n.api == want then return n end; package.loaded[\"ferry.note\"] = nil; local ok, m = pcall(require, \"ferry.note\"); if not ok then package.loaded[\"ferry.note\"] = n; return n end; m.state = n.state; if n.host ~= n.default_host then m.host = n.host end; return m end)($note_api)"

# The GUI module, as a Lua expression (rtp fixed by the caller). A server
# that loaded it before gui.api reached gui_api reloads it; its setup()
# then replaces the old autocmds (same augroup).
gui_api=2
gui_mod="(function(want) local g = require(\"ferry.gui\"); if (g.api or 0) >= want then return g end; package.loaded[\"ferry.gui\"] = nil; local ok, m = pcall(require, \"ferry.gui\"); if ok and type(m) == \"table\" then return m end; package.loaded[\"ferry.gui\"] = g; return g end)($gui_api)"

ghostty_bin() {
  command -v ghostty 2>/dev/null && return
  local app=/Applications/Ghostty.app/Contents/MacOS/ghostty
  [ -x "$app" ] && echo "$app"
}

# Values of `key = value` lines in config text, non-empty ones joined by ",".
cfg_val() { printf '%s\n' "$2" | sed -n "s/^$1 = //p" | sed '/^[[:space:]]*$/d' | paste -sd, - ; }

# GUI settings as a Vim dict: {'font': 'Family:h13', 'bg': '#001e27'}.
# Overrides first, then Ghostty's own settings, then its defaults. Each
# ghostty call is cut off after 1 s; any failure just leaves a value empty.
gui_dict() {
  local font=${FERRY_GUI_FONT:-} bg=${FERRY_GUI_BG:-} g user="" def="" fam size
  if { [ -z "$font" ] || [ -z "$bg" ]; } && g=$(ghostty_bin); then
    user=$(perl -e 'alarm 1; exec @ARGV' "$g" +show-config </dev/null 2>/dev/null)
    fam=$(cfg_val font-family "$user"); size=$(cfg_val font-size "$user")
    local ubg; ubg=$(cfg_val background "$user")
    if [ -z "$fam" ] || [ -z "$size" ] || [ -z "$ubg" ]; then
      def=$(perl -e 'alarm 1; exec @ARGV' "$g" +show-config --default </dev/null 2>/dev/null)
      [ -n "$fam" ] || fam=$(cfg_val font-family "$def")
      [ -n "$size" ] || size=$(cfg_val font-size "$def")
      [ -n "$ubg" ] || ubg=$(cfg_val background "$def")
    fi
    size=${size%%,*}
    if [ -z "$font" ] && [ -n "$fam" ]; then font=$fam${size:+:h$size}; fi
    [ -n "$bg" ] || bg=${ubg%%,*}
  fi
  printf "{'font': %s, 'bg': %s}" "$(vimstr "$font")" "$(vimstr "$bg")"
}

alive() { [ -S "$sock" ] && [ "$(rexpr 1 2>/dev/null)" = 1 ]; }

need_server() {
  alive || { echo "ferry-host: no server on $sock (run ensure)" >&2; exit 1; }
}

# Call require("ferry.note").<fn>(dict) on the server and print the
# result. Fails if the server is down or the call raised an error.
call() { # fn dict
  local out
  out=$(rexpr "luaeval('$note_mod.$1(_A)', $2)" 2>&1) \
    || { echo "ferry-host: $1 failed: $out" >&2; return 1; }
  printf '%s\n' "$out"
}

ensure() {
  if alive; then
    echo "ferry-host: running on $sock"
  else
    rm -f "$sock"
    # shellcheck disable=SC2086 # FERRY_HOST_NVIM_FLAGS is split on purpose.
    nohup "$nvim_bin" --headless --listen "$sock" ${FERRY_HOST_NVIM_FLAGS:-} \
      --cmd "set rtp^=${root// /\\ }" </dev/null >/dev/null 2>&1 &
    local i
    for i in $(seq 100); do alive && break; sleep 0.05; done
    alive || { echo "ferry-host: server did not start on $sock" >&2; return 1; }
    # The server answers before its init has finished; a plugin manager
    # there may still reset rtp. Wait for VimEnter (up to 5 s) so the rtp
    # fix below sticks.
    for i in $(seq 100); do [ "$(rexpr v:vim_did_enter 2>/dev/null)" = 1 ] && break; sleep 0.05; done
    echo "ferry-host: started on $sock"
  fi
  # Put the repo on the runtimepath (note_mod does it; a reused server may
  # lack it) and load the note module now, so the first show is not slowed
  # by it. Also hand it the GUI settings (re-read on every ensure).
  rexpr "luaeval('(function(a) local n = $note_mod; return $gui_mod.setup(a) end)(_A)', $(gui_dict))" >/dev/null
}

show() { # [--talk] target window [seedfile]
  need_server
  local talk=""
  if [ "${1:-}" = --talk ]; then talk=1; shift; fi
  local seed=${3:-}
  if [ -n "$seed" ]; then seed=$(cd "$(dirname "$seed")" && pwd)/$(basename "$seed"); fi
  # The reply is the note's path, plus a "?gui" line when the server has no
  # GUI settings yet (started before they existed): those are loaded after.
  local out
  out=$(rexpr "luaeval('(function(a) local p = $note_mod.show(a); if vim.g.ferry_gui == nil then p = p .. \"\\n?gui\" end; return p end)(_A)', {'target': $(vimstr "${1:-}"), 'window': $(vimstr "${2:-}"), 'seed': $(vimstr "$seed"), 'dir': $(vimstr "$notes"), 'sidebar': $(vimstr "${FERRY_SIDEBAR:-}"), 'talk': $(vimstr "$talk")})" 2>&1) \
    || { echo "ferry-host: show failed: $out" >&2; return 1; }
  printf '%s\n' "${out%%$'\n'*}"
  case $out in
    *$'\n?gui') rexpr "luaeval('(function(a) $rtp_fix; return $gui_mod.setup(a) end)(_A)', $(gui_dict))" >/dev/null 2>&1 ;;
  esac
  return 0
}

status() {
  if alive; then echo "up uis=$(rexpr 'len(nvim_list_uis())')"; else echo down; fi
}

stop() {
  if alive; then
    # Quit once this request has returned; does not need the note module.
    rexpr "luaeval('vim.schedule(function() vim.cmd(\"silent! wall | qall!\") end)')" >/dev/null 2>&1
    local i
    for i in $(seq 100); do [ -e "$sock" ] || break; sleep 0.05; done
  fi
  rm -f "$sock"
}

case ${1:-} in
  ensure)     ensure ;;
  show)       shift; show "$@" ;;
  talk)       need_server; call talk "{'dir': $(vimstr "$notes")}" ;;
  release)    need_server
              force=''; [ "${2:-}" = --force ] && force=1
              call release "{'force': $(vimstr "$force"), 'dir': $(vimstr "$notes")}" ;;
  flow-state) need_server; call flow_state '{}' ;;
  draft)      need_server; call draft "{'dir': $(vimstr "$notes")}" ;;
  attach-cmd) printf '%q --server %q --remote-ui\n' "$nvim_bin" "$sock" ;;
  status)     status ;;
  stop)       stop ;;
  *) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
