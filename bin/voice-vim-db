#!/usr/bin/env python3
"""voice-vim-db: owns the session history database.

  voice-vim-db start  <id> <target> <seed-file>      record a new session
  voice-vim-db finish <id> <outcome> <final-file> [<target>]
                                                      record how it ended (and
                                                      where it went: a target spec)
  voice-vim-db list   [--limit N] [--exclude ID]      JSON array, newest first
  voice-vim-db get    <id>                            JSON object
  voice-vim-db delete <id>
  voice-vim-db path                                   print the database path

Database: $VOICE_VIM_DB or ~/Library/Application Support/voice-vim/history.sqlite
Set VOICE_VIM_HISTORY=0 to make start/finish no-ops.
"""
import json
import os
import sqlite3
import sys
from datetime import datetime, timezone, timedelta

SCHEMA = """
CREATE TABLE IF NOT EXISTS sessions (
  id          TEXT PRIMARY KEY,
  started_at  TEXT NOT NULL,      -- ISO 8601 UTC
  ended_at    TEXT,
  target      TEXT,               -- target spec (app:<bundle>#<window>, clipboard,
                                  -- tmux:…); older rows hold a bare bundle id
  seed_text   TEXT,               -- selection the buffer started with
  final_text  TEXT,               -- buffer contents at exit
  outcome     TEXT NOT NULL       -- open | submitted | cancelled
);
CREATE INDEX IF NOT EXISTS sessions_started ON sessions(started_at DESC);
"""

APP_NAMES = {
    "com.google.Chrome": "Chrome",
    "com.googlecode.iterm2": "iTerm2",
    "com.mitchellh.ghostty": "Ghostty",
    "com.tinyspeck.slackmacgap": "Slack",
    "com.apple.Safari": "Safari",
    "com.apple.Notes": "Notes",
    "com.apple.mail": "Mail",
    "com.microsoft.VSCode": "VS Code",
    "com.todesktop.230313mzl4w4u92": "Cursor",
    "com.anthropic.claudefordesktop": "Claude",
    "notion.id": "Notion",
}


def db_path():
    return os.environ.get("VOICE_VIM_DB") or os.path.expanduser(
        "~/Library/Application Support/voice-vim/history.sqlite")


def connect():
    path = db_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    con = sqlite3.connect(path)
    con.executescript(SCHEMA)
    return con


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def short_app(target):
    """Short label for a target spec (lua/voice-vim/target.lua) or, in older
    rows, a bare bundle id."""
    if not target:
        return "?"
    kind, sep, rest = target.partition(":")
    if not sep:
        if target == "clipboard":
            return "clipboard"
        bundle = target
    elif kind == "app":
        bundle = rest.split("#", 1)[0]
    else:
        return kind
    if not bundle:
        return "?"
    return APP_NAMES.get(bundle) or bundle.rsplit(".", 1)[-1]


def date_label(dt_local, today):
    d = dt_local.date()
    if d == today:
        return "Today"
    if d == today - timedelta(days=1):
        return "Yesterday"
    if (today - d).days < 7:
        return dt_local.strftime("%A")
    return dt_local.strftime("%b %-d")


def row_to_obj(row):
    started = datetime.strptime(row["started_at"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    local = started.astimezone()
    text = row["final_text"] or ""
    first = next((l for l in text.splitlines() if l.strip()), "")
    return {
        "id": row["id"],
        "started_at": row["started_at"],
        "time": local.strftime("%H:%M"),
        "date_label": date_label(local, datetime.now().date()),
        "target": row["target"] or "",
        "app": short_app(row["target"]),
        "outcome": row["outcome"],
        "preview": first,
        "text": text,
        "words": len(text.split()),
    }


def main(argv):
    if not argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    cmd, args = argv[0], argv[1:]
    enabled = os.environ.get("VOICE_VIM_HISTORY", "1") != "0"

    if cmd == "path":
        print(db_path())
        return 0

    if cmd == "start":
        if not enabled:
            return 0
        sid, target, seed_file = args
        con = connect()
        con.execute("INSERT OR REPLACE INTO sessions(id, started_at, target, seed_text, outcome) VALUES (?,?,?,?,'open')",
                    (sid, now(), target, read(seed_file)))
        con.commit()
        return 0

    if cmd == "finish":
        if not enabled:
            return 0
        sid, outcome, final_file = args[:3]
        target = args[3] if len(args) > 3 else ""
        text = read(final_file)
        con = connect()
        if outcome == "cancelled" and not text.strip():
            con.execute("DELETE FROM sessions WHERE id=?", (sid,))
        else:
            con.execute("UPDATE sessions SET ended_at=?, final_text=?, outcome=?, "
                        "target=CASE WHEN ?='' THEN target ELSE ? END WHERE id=?",
                        (now(), text, outcome, target, target, sid))
        con.commit()
        return 0

    con = connect()
    con.row_factory = sqlite3.Row

    if cmd == "list":
        limit, exclude = 200, None
        i = 0
        while i < len(args):
            if args[i] == "--limit":
                limit = int(args[i + 1]); i += 2
            elif args[i] == "--exclude":
                exclude = args[i + 1]; i += 2
            else:
                i += 1
        rows = con.execute(
            "SELECT * FROM sessions WHERE outcome != 'open' AND (? IS NULL OR id != ?) "
            "ORDER BY started_at DESC, rowid DESC LIMIT ?", (exclude, exclude, limit)).fetchall()
        json.dump([row_to_obj(r) for r in rows], sys.stdout)
        return 0

    if cmd == "get":
        row = con.execute("SELECT * FROM sessions WHERE id=?", (args[0],)).fetchone()
        if row is None:
            return 1
        json.dump(row_to_obj(row), sys.stdout)
        return 0

    if cmd == "delete":
        con.execute("DELETE FROM sessions WHERE id=?", (args[0],))
        con.commit()
        return 0

    print("unknown command: " + cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
