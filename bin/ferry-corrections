#!/usr/bin/env python3
"""ferry-corrections: words you keep fixing after Wispr Flow dictates them.

  ferry-corrections [--flow-db PATH] [--apps A,B] [--min N] [--json]

Pairs each Flow dictation into ferry with the sent note it went into,
diffs what Flow typed against what you sent, and prints the 1-3 word
substitutions you made in at least N notes, most frequent first:

  3× cube control → kubectl

Add the ones you want as words in Flow's own Dictionary (Flow app →
Dictionary). This script never writes Flow's data and never opens Flow's
live files with SQLite: it copies the database and its -wal (never the
-shm) into a private temp dir, as an APFS clone (`cp -c`) or else a plain
copy, and opens only that copy. A copy that changed while it was taken or
fails `PRAGMA quick_check` is retaken, up to 3 times; then it exits 2.
The temp dir is removed on every path.

  --flow-db  default ~/Library/Application Support/Wispr Flow/flow.sqlite
  --apps     Flow `app` values that are ferry (default local.ferry,
             com.neovide.neovide; compared without case)
  --min N    show pairs seen in at least N notes (default 2)
  --json     a JSON array of {"count", "wrong", "right"} instead

Notes: $FERRY_NOTES_DIR or ~/notes/scratchpads, only `state: sent` notes
with `created` and `sent` times. A Flow row belongs to the sent note whose
created..sent window (5 s grace either side) holds its timestamp; when
several do, the shortest window wins. Flow's text is pastedText, else
formattedText, else asrText. Pairs whose right side Flow's Dictionary
already holds (as a phrase or a replacement) are left out, and so are changes to a first
letter's case alone (sentence case).
"""
import difflib
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import sqlite3
import sys
import subprocess
import tempfile
import time
import urllib.parse
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
NOTES_BIN = os.path.join(HERE, "ferry-notes")
DEFAULT_DB = "~/Library/Application Support/Wispr Flow/flow.sqlite"
DEFAULT_APPS = "local.ferry,com.neovide.neovide"
GRACE = 5.0
MAX_WORDS = 3


def load_notes():
    """bin/ferry-notes as a module, for its frontmatter parser."""
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("ferry_notes", NOTES_BIN)
    spec = importlib.util.spec_from_loader("ferry_notes", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


# ---------------------------------------------------------------------------
# Flow's database, read only

def connect_ro(path):
    uri = "file:%s?mode=ro" % urllib.parse.quote(os.path.abspath(path))
    con = sqlite3.connect(uri, uri=True)
    con.text_factory = lambda b: b.decode("utf-8", "replace")
    return con


COPY_TRIES = 3


class CopyFailed(Exception):
    pass


def clone(src, dst):
    """APFS clone of src at dst, else a plain copy."""
    if subprocess.run(["cp", "-c", src, dst], stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL).returncode != 0:
        shutil.copyfile(src, dst)


def stamp(path):
    """(size, mtime) of path and its -wal, to spot a write during the copy."""
    out = []
    for p in (path, path + "-wal"):
        try:
            st = os.stat(p)
            out.append((st.st_size, st.st_mtime_ns))
        except FileNotFoundError:
            out.append(None)
    return out


def read_flow(path, apps):
    """(history rows [(ts, text)], dictionary words casefolded).

    SQLite never opens Flow's live files: even `mode=ro` can create a -wal
    or -shm beside them (if Flow quits between checks) or rewrite a stale
    -shm after a crash. So the db and its -wal (never the -shm) are copied
    into a private temp dir and only the copy is opened. A copy taken while
    Flow wrote (the files changed meanwhile, the copy fails quick_check or
    raises DatabaseError) is retaken, up to COPY_TRIES times."""
    why = ""
    for attempt in range(COPY_TRIES):
        if attempt:
            time.sleep(0.2)
        with tempfile.TemporaryDirectory(prefix="ferry-corrections.") as d:
            copy = os.path.join(d, "flow.sqlite")
            before = stamp(path)
            clone(path, copy)
            if before[1] is not None:
                try:
                    clone(path + "-wal", copy + "-wal")
                except FileNotFoundError:
                    pass  # checkpointed and removed meanwhile; stamp differs
            if stamp(path) != before:
                why = "it changed while it was copied"
                continue
            con = connect_ro(copy)
            try:
                check = con.execute("PRAGMA quick_check").fetchone()
                if not check or check[0] != "ok":
                    why = "quick_check: %s" % (check[0] if check else "no answer")
                    continue
                return query(con, apps)
            except sqlite3.DatabaseError as e:
                why = str(e)
            finally:
                con.close()
    raise CopyFailed("no sound copy after %d tries (%s)" % (COPY_TRIES, why))


def query(con, apps):
    try:
        marks = ",".join("?" * len(apps))
        rows = con.execute(
            "SELECT timestamp, COALESCE(NULLIF(pastedText, ''), NULLIF(formattedText, ''),"
            " asrText) FROM History WHERE lower(app) IN (%s)" % marks,
            [a.lower() for a in apps]).fetchall()
        try:
            words = con.execute("SELECT phrase, replacement FROM Dictionary"
                                " WHERE COALESCE(isDeleted, 0) = 0").fetchall()
        except sqlite3.Error:
            words = []
    finally:
        con.close()
    history = [(flow_ts(ts), text) for ts, text in rows if text]
    dictionary = {w.casefold() for row in words for w in row if w}
    return [h for h in history if h[0] is not None], dictionary


def flow_ts(v):
    """Epoch seconds for a Flow timestamp (ISO text, or epoch s or ms)."""
    if v is None:
        return None
    if isinstance(v, (int, float)) or re.fullmatch(r"\s*[0-9]+(\.[0-9]+)?\s*", str(v)):
        n = float(v)
        return n / 1000 if n > 1e11 else n
    s = str(v).strip().replace(" ", "T", 1)
    s = re.sub(r"\s*Z$", "+00:00", s)
    s = re.sub(r"\s+([+-][0-9]{2}:?[0-9]{2})$", r"\1", s)
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)  # Flow (Sequelize) stores UTC
    return dt.timestamp()


# ---------------------------------------------------------------------------
# Notes

def sent_notes(notes):
    """[(created ts, sent ts, id, body)] for sent notes with both times."""
    out = []
    for path in notes.note_files(notes.notes_dir()):
        try:
            _, meta, lines, _ = notes.parse(notes.read_text(path))
        except OSError:
            continue
        if notes.meta_str(meta, "state", "draft") != "sent":
            continue
        created = notes.iso_ts(notes.meta_str(meta, "created"))
        sent = notes.iso_ts(notes.meta_str(meta, "sent"))
        if created is None or sent is None or sent < created:
            continue
        ident = notes.meta_str(meta, "id") or os.path.basename(path)[:-3]
        out.append((created, sent, ident, notes.clean("\n".join(lines))))
    return out


def owner(notes, ts):
    """Index of the note whose window holds ts (shortest window), or None."""
    best = None
    for i, (created, sent, _, _) in enumerate(notes):
        if created - GRACE <= ts <= sent + GRACE:
            if best is None or sent - created < notes[best][1] - notes[best][0]:
                best = i
    return best


# ---------------------------------------------------------------------------
# Diff

EDGE = "\"'`.,;:!?()[]{}<>*_~“”‘’…—–-"


def words(text):
    out = []
    for tok in text.split():
        core = tok.strip(EDGE)
        if core:
            out.append(core)
    return out


def substitutions(dictated, final):
    """Set of (wrong, right) 1-3 word replacements from dictated to final."""
    a, b = words(dictated), words(final)
    pairs = set()
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op != "replace" or not (1 <= i2 - i1 <= MAX_WORDS and 1 <= j2 - j1 <= MAX_WORDS):
            continue
        wrong, right = " ".join(a[i1:i2]), " ".join(b[j1:j2])
        if wrong[1:] == right[1:] and wrong[:1].lower() == right[:1].lower():
            continue  # sentence case only
        pairs.add((wrong, right))
    return pairs


def corrections(history, notes, dictionary):
    """[(count, wrong, right)], most notes first."""
    dictated = {}
    for ts, text in sorted(history, key=lambda h: h[0]):
        i = owner(notes, ts)
        if i is not None:
            dictated.setdefault(i, []).append(text)
    counts, spellings = {}, {}
    for i, texts in dictated.items():
        seen = set()
        for wrong, right in substitutions(" ".join(texts), notes[i][3]):
            if right.casefold() in dictionary:
                continue  # Flow already knows the right word
            key = (wrong.casefold(), right)  # `Cube control` = `cube control`
            spelled = spellings.setdefault(key, {})
            spelled[wrong] = spelled.get(wrong, 0) + 1
            if key not in seen:
                seen.add(key)
                counts[key] = counts.get(key, 0) + 1
    found = []
    for key, n in counts.items():
        # the most common spelling of the wrong side; ties by sort order
        wrong = min(spellings[key].items(), key=lambda s: (-s[1], s[0]))[0]
        found.append((n, wrong, key[1]))
    return sorted(found, key=lambda c: (-c[0], c[1].casefold(), c[2]))


# ---------------------------------------------------------------------------

def fail(msg):
    print("ferry-corrections: " + msg, file=sys.stderr)
    return 2


def main(argv):
    db, apps, least, as_json = DEFAULT_DB, DEFAULT_APPS, 2, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--json":
            as_json = True; i += 1
            continue
        if a not in ("--flow-db", "--apps", "--min"):
            return fail("bad argument: %s (see --help)" % a)
        if i + 1 >= len(argv):
            return fail("%s needs a value" % a)
        v = argv[i + 1]; i += 2
        if a == "--flow-db":
            db = v
        elif a == "--apps":
            apps = v
        else:
            try:
                least = int(v)
            except ValueError:
                return fail("--min needs a number")
    db = os.path.expanduser(db)
    app_list = [x.strip() for x in apps.split(",") if x.strip()]
    if not app_list:
        return fail("--apps is empty")
    if not os.path.isfile(db):
        return fail("no Wispr Flow database: " + db)
    try:
        history, dictionary = read_flow(db, app_list)
    except (CopyFailed, sqlite3.Error, OSError) as e:
        return fail("cannot read %s: %s" % (db, str(e).replace("\n", " ")))

    found = [c for c in corrections(history, sent_notes(load_notes()), dictionary)
             if c[0] >= least]
    if as_json:
        json.dump([{"count": n, "wrong": w, "right": r} for n, w, r in found], sys.stdout)
        print()
    elif not found:
        print("no corrections seen in %d or more notes" % least)
    else:
        for n, w, r in found:
            print("%d× %s → %s" % (n, w, r))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
