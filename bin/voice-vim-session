#!/usr/bin/env bash
# voice-vim-session: runs inside the terminal window (Ghostty by default)
# that voice-vim opens.
#
# Usage: voice-vim-session <tmpfile> <target-bundle-id> [target-window-id] [session-token]
#
# Opens the editor on <tmpfile> in insert mode, waits for it to exit, then
# decides whether to submit or cancel:
#   - editor exit code != 0 (e.g. :cq)            -> cancel
#   - file unchanged from its seed, or empty       -> cancel
#   - otherwise                                    -> submit
# VOICE_VIM_DRY_RUN=1 prints the decision (and the callback URL: on submit
# as `voice-vim-url: ...`, on cancel as `voice-vim-cancel-url: ...`) and
# exits without opening it.
# The session token (4th argument, or VOICE_VIM_SESSION_TOKEN) is passed back
# in both URLs so Hammerspoon can close this window; cancel also has it
# refocus the target window.
# Submit hands the file back to Hammerspoon via a hammerspoon:// URL, which
# focuses the target window (or app) and pastes it there. If Hammerspoon is
# not running, falls back to osascript (requires Accessibility for the
# terminal).
set -u

# Launched from Hammerspoon (via Ghostty -e) we inherit a bare launchd PATH,
# so make sure Homebrew and user bins are reachable for nvim, python3, etc.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:/usr/local/bin:$PATH"

file=${1:?tmpfile required}
target=${2:-}
window=${3:-}
token=${4:-${VOICE_VIM_SESSION_TOKEN:-}}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(dirname "$here")

editor=${VOICE_VIM_EDITOR:-nvim}
seed=$(mktemp -t voice-vim-seed)
cp "$file" "$seed"

# History: every session is recorded in a SQLite database (see
# bin/voice-vim-db). VOICE_VIM_HISTORY=0 disables recording.
export VOICE_VIM_SESSION_ID=${VOICE_VIM_SESSION_ID:-$(uuidgen | tr 'A-Z' 'a-z')}
"$here/voice-vim-db" start "$VOICE_VIM_SESSION_ID" "$target" "$seed" || true

cleanup() { rm -f "$seed"; }
trap cleanup EXIT

start_flow() {
  # Give the editor a beat to be focused and in insert mode, then start a
  # hands-free Flow session. Off by default until the user opts in.
  if [ "${VOICE_VIM_AUTOSTART_FLOW:-0}" = "1" ]; then
    (sleep 0.4; open -g "wispr-flow://start-hands-free") &
  fi
}

start_flow
"$editor" -c "source $root/vim/voice-vim.vim" -c startinsert -- "$file"
status=$?

decide() {
  if [ "$status" -ne 0 ]; then echo cancel; return; fi
  if [ ! -s "$file" ]; then echo cancel; return; fi
  if cmp -s "$file" "$seed"; then echo cancel; return; fi
  # Whitespace-only is a cancel too.
  if ! grep -q '[^[:space:]]' "$file"; then echo cancel; return; fi
  echo submit
}

outcome=$(decide)
echo "voice-vim: $outcome"
case $outcome in
  submit) "$here/voice-vim-db" finish "$VOICE_VIM_SESSION_ID" submitted "$file" || true ;;
  *)      "$here/voice-vim-db" finish "$VOICE_VIM_SESSION_ID" cancelled "$file" || true ;;
esac

# URL-encode the path, bundle id, window id and token for the callback.
enc() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1],safe=""))' "$1"; }
submit_url() {
  local url="hammerspoon://voicevim-submit?file=$(enc "$file")&target=$(enc "$target")"
  if [ -n "$window" ]; then url="$url&window=$(enc "$window")"; fi
  if [ -n "$token" ]; then url="$url&session=$(enc "$token")"; fi
  printf '%s\n' "$url"
}
cancel_url() {
  printf 'hammerspoon://voicevim-cancel?target=%s&window=%s&session=%s\n' \
    "$(enc "$target")" "$(enc "$window")" "$(enc "$token")"
}

if [ "${VOICE_VIM_DRY_RUN:-0}" = "1" ]; then
  if [ "$outcome" = submit ]; then
    echo "voice-vim-url: $(submit_url)"
  else
    echo "voice-vim-cancel-url: $(cancel_url)"
  fi
  exit 0
fi

if [ "$outcome" = submit ]; then
  if pgrep -xq Hammerspoon; then
    open -g "$(submit_url)"
  else
    "$here/voice-vim-paste" "$file" "$target"
    rm -f "$file"
  fi
else
  rm -f "$file"
  # Hammerspoon closes this window and refocuses the target window.
  if pgrep -xq Hammerspoon; then open -g "$(cancel_url)"; fi
fi

# Hammerspoon closes the Ghostty window (Ghostty may leave a "Process
# exited" screen otherwise). iTerm2 needs a nudge.
if [ "${TERM_PROGRAM:-}" = "iTerm.app" ] && [ -n "${ITERM_SESSION_ID:-}" ]; then
  sid=${ITERM_SESSION_ID#*:}
  osascript - "$sid" <<'APPLESCRIPT' >/dev/null 2>&1 &
on run argv
  set sid to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if (unique id of s) is sid then
            close s
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
APPLESCRIPT
fi
