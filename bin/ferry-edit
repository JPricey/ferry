#!/usr/bin/env bash
# ferry-edit: $EDITOR / $VISUAL / $GIT_EDITOR for ferry. Opens one file in
# the running ferry instance (lua/ferry/edit.lua in the ferry-host nvim
# server), shows ferry over the terminal through Hammerspoon, and waits
# until the edit ends:
#   Ctrl-X, ZZ, :wq, :x   the file is written, exit 0
#   Ctrl-Q, ZQ            the file is left as it was, exit 1
#   :q, the hotkey        ferry hides, the edit stays pending
# Ctrl-C, TERM or HUP here abort the edit in ferry (file unchanged; a Flow
# recording in it is stopped first) and exit 130. A server that dies while
# the edit is shown exits 1.
#
# Usage: ferry-edit <file>
#
# It runs ${FERRY_EDIT_FALLBACK:-nvim} with the same arguments in this
# terminal instead when: there is not exactly one file argument,
# FERRY_EDIT_TERMINAL=1, an SSH session, Hammerspoon is not running, no
# ferry.app or Neovide.app, `ferry-host ensure` fails, ferry is busy (an
# edit pending, or Flow recording in the note), or ferry is not shown
# within FERRY_EDIT_SHOW_TIMEOUT seconds.
#
# Environment:
#   FERRY_SOCK               server socket (default ${TMPDIR}/ferry.sock)
#   FERRY_EDIT_FALLBACK      terminal editor command, split on spaces
#                            (default nvim)
#   FERRY_EDIT_TERMINAL      1: always use the fallback
#   FERRY_EDIT_SHOW_TIMEOUT  seconds to wait for ferry to show (default 5)
#   FERRY_EDIT_DIR           done files (default ${TMPDIR}/ferry-edit)
#   FERRY_APP                the ferry.app wrapper (default
#                            ~/Applications/ferry.app); its bundle id
#                            local.ferry is what "ferry is frontmost" means,
#                            else com.neovide.neovide
#
# "Shown": nvim saw FocusGained in the edit, or ferry's app is frontmost
# (lsappinfo), which covers ferry already in front when the edit started.
set -u

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:/usr/local/bin:$PATH"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(dirname "$here")
host="$here/ferry-host"
tmp=${TMPDIR:-/tmp}; tmp=${tmp%/}
sock=${FERRY_SOCK:-$tmp/ferry.sock}
app=${FERRY_APP:-$HOME/Applications/ferry.app}
show_timeout=${FERRY_EDIT_SHOW_TIMEOUT:-5}
edit_dir=${FERRY_EDIT_DIR:-$tmp/ferry-edit}

say() { printf 'ferry-edit: %s\n' "$*" >&2; }

fallback() { # why
  say "$1; using ${FERRY_EDIT_FALLBACK:-nvim}"
  # shellcheck disable=SC2086 # the fallback command is split on purpose
  exec ${FERRY_EDIT_FALLBACK:-nvim} "${args[@]}"
}

args=("$@")
[ $# -eq 1 ] || fallback "not exactly one file argument"
case $1 in -*|+*|'') fallback "not a file argument: $1" ;; esac
[ -d "$1" ] && fallback "$1 is a directory"
[ "${FERRY_EDIT_TERMINAL:-}" = 1 ] && fallback "FERRY_EDIT_TERMINAL=1"
[ -n "${SSH_CONNECTION:-}${SSH_CLIENT:-}${SSH_TTY:-}" ] && fallback "SSH session"
pgrep -xq Hammerspoon >/dev/null 2>&1 || fallback "Hammerspoon is not running"
if [ -d "$app" ]; then
  bundle=local.ferry
elif [ -d /Applications/Neovide.app ] || [ -d "$HOME/Applications/Neovide.app" ]; then
  bundle=com.neovide.neovide
else
  fallback "no ferry.app or Neovide.app"
fi
nvim_bin=$(command -v nvim) || fallback "nvim not found"

file=$1
case $file in /*) ;; *) file=$PWD/$file ;; esac

"$host" ensure >/dev/null 2>&1 || fallback "ferry-host ensure failed"

# --- the server's edit module ----------------------------------------------
vimstr() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }
luastr() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\'/\'\'}; printf '"%s"' "$s"; }
# Each remote call is cut off after 3 s, so a hung server cannot hang us.
rexpr() { perl -e 'alarm 3; exec @ARGV' "$nvim_bin" --server "$sock" --remote-expr "$1" 2>/dev/null; }
# require("ferry.edit"), repo on the runtimepath (as in ferry-host); a
# server holding an older module (api below edit_api) reloads it, keeping
# its state.
edit_api=2
edit_mod="(function(want) local r = $(luastr "$root"); if not vim.tbl_contains(vim.opt.rtp:get(), r) then vim.opt.rtp:prepend(r) end; local e = require(\"ferry.edit\"); if (e.api or 0) >= want then return e end; package.loaded[\"ferry.edit\"] = nil; local ok, m = pcall(require, \"ferry.edit\"); if not ok then package.loaded[\"ferry.edit\"] = e; return e end; m.state = e.state; return m end)($edit_api)"
call() { rexpr "luaeval('$edit_mod.$1(_A)', $2)"; } # fn dict

mkdir -p "$edit_dir" || fallback "cannot create $edit_dir"
done_file=$edit_dir/$$-$RANDOM$RANDOM
rm -f "$done_file"
dict="{'file': $(vimstr "$file"), 'done': $(vimstr "$done_file")}"

abort() { # end the server edit; wait for it when Flow's paste is due
  [ -n "$started" ] || return 0
  started=
  local a; a=$(call abort "{'done': $(vimstr "$done_file")}")
  if [ "$a" = aborting ]; then
    for _ in $(seq 60); do [ -s "$done_file" ] && break; sleep 0.1; done
  fi
  rm -f "$done_file" "$done_file.tmp"
}
on_signal() { abort; exit 130; }
# Armed before start: a signal while start is in flight still aborts it
# (abort of an edit that never started is a no-op).
started=1
trap on_signal INT TERM HUP

r=$(call start "$dict")
case $r in
  ok) ;;
  busy) started=; fallback "ferry is busy" ;;
  *) started=; fallback "ferry could not open the file (${r:-no answer})" ;;
esac

front() { # 1 when ferry's app is frontmost
  local asn
  asn=$(lsappinfo front 2>/dev/null) || { echo 0; return; }
  case $(lsappinfo info -only bundleid "$asn" 2>/dev/null) in
    *"=\"$bundle\""*) echo 1 ;;
    *) echo 0 ;;
  esac
}
status() { call status "{'done': $(vimstr "$done_file"), 'front': $(front)}"; }

open -g "hammerspoon://ferry-edit" >/dev/null 2>&1 || { abort; fallback "could not open hammerspoon://ferry-edit"; }

# --- wait for ferry to show the edit ----------------------------------------
SECONDS=0
while :; do
  s=$(status); [ -n "$s" ] || s=gone
  case $s in
    shown|done) break ;;  # done: it ended before we saw it shown
    gone) started=; fallback "ferry's server went away" ;;
  esac
  if [ "$SECONDS" -ge "$show_timeout" ]; then
    abort; fallback "ferry was not shown within ${show_timeout} s"
  fi
  sleep 0.1
done

# --- wait for the edit to end -----------------------------------------------
n=0
while [ ! -s "$done_file" ]; do
  sleep 0.1
  n=$((n + 1))
  [ $((n % 10)) -eq 0 ] || continue
  # Once a second: is the server, and our edit in it, still there?
  s=$(call status "{'done': $(vimstr "$done_file")}"); [ -n "$s" ] || s=gone
  if [ "$s" = gone ] || { [ "$s" = done ] && sleep 0.2 && [ ! -s "$done_file" ]; }; then
    started=
    say "ferry's server went away; the file was not changed by it"
    exit 1
  fi
done
started=
code=$(head -n 1 "$done_file" 2>/dev/null)
rm -f "$done_file"
case $code in
  0) exit 0 ;;
  *) exit 1 ;;
esac
