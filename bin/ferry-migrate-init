#!/usr/bin/env bash
# ferry-migrate-init: drop the old Option+V hotkey from init.lua.
# Usage: ferry-migrate-init [init.lua]   (default ~/.hammerspoon/init.lua)
# Inside the require("ferry").start({ ... }) block, removes the line
#   hotkey = { { "alt" }, "v" },
# so the module default (Ctrl+Option+V) applies. Every other line, including
# a custom hotkey line, is left alone. Before changing anything it copies the
# file to init.lua.bak (or init.lua.bak.<time> if that exists). Running it
# again changes nothing. Does not reload Hammerspoon.
set -euo pipefail
init=${1:-$HOME/.hammerspoon/init.lua}

if ! [ -f "$init" ]; then
  echo "ferry-migrate-init: $init not found" >&2
  exit 1
fi

tmp=$(mktemp -d -t ferry-migrate)
trap 'rm -rf "$tmp"' EXIT

# Lines inside the ferry start block that are exactly the Option+V
# hotkey (any spacing, trailing comma optional) are dropped and recorded.
awk -v removed="$tmp/removed" '
  /require\("ferry"\)\.start\(\{[ \t]*$/ { inblock = 1; print; next }
  inblock && /^[ \t]*\}\)/ { inblock = 0 }
  inblock && /^[ \t]*hotkey[ \t]*=[ \t]*\{[ \t]*\{[ \t]*"alt"[ \t]*\}[ \t]*,[ \t]*"v"[ \t]*\}[ \t]*,?[ \t]*$/ {
    printf "  line %d: %s\n", NR, $0 > removed
    next
  }
  { print }
' "$init" > "$tmp/new"

if cmp -s "$init" "$tmp/new"; then
  echo "ferry-migrate-init: no Option+V hotkey line in $init; nothing changed"
  exit 0
fi

bak="$init.bak"
[ -e "$bak" ] && bak="$init.bak.$(date +%Y%m%d%H%M%S)"
cp -p "$init" "$bak"
# Write through the existing file so a symlinked init.lua stays a symlink.
cat "$tmp/new" > "$init"

echo "ferry-migrate-init: updated $init"
echo "removed:"
cat "$tmp/removed"
echo "backup: $bak"
echo "Reload Hammerspoon to use the default hotkey, Ctrl+Option+V."
