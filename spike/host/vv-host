#!/usr/bin/env bash
# vv-host: shared helper for the single-instance host spike. Manages one
# long-lived nvim server and the note in it. Every call goes through
# `nvim --server <sock> --remote-expr`; the server side is note.lua.
#
# Usage: vv-host ensure|new|draft|attach-cmd|stop
#   ensure      start `nvim --headless --listen <sock>` unless one answers
#   new         open a fresh note in insert mode (prints its path)
#   draft       write the note and set g:voicevim_draft (prints its path)
#   attach-cmd  print the command a UI runs to attach to the server
#   stop        quit the server and remove the socket
#
# Environment:
#   VOICE_VIM_SOCK          socket (default ${TMPDIR}/voice-vim-spike.sock)
#   VOICE_VIM_SPIKE_NOTES   note folder (default ${TMPDIR}/voice-vim-spike-notes)
#   VV_HOST_NVIM_FLAGS      extra flags for the server nvim (tests: --clean)
set -u

# Called from Hammerspoon we inherit a bare launchd PATH, so make sure
# Homebrew and user bins are reachable for nvim.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/bin:/usr/local/bin:$PATH"

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
tmp=${TMPDIR:-/tmp}; tmp=${tmp%/}
sock=${VOICE_VIM_SOCK:-$tmp/voice-vim-spike.sock}
notes=${VOICE_VIM_SPIKE_NOTES:-$tmp/voice-vim-spike-notes}
nvim_bin=$(command -v nvim) || { echo "vv-host: nvim not found" >&2; exit 1; }

# Quote a string as a Vim script literal.
vimstr() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }

rexpr() { "$nvim_bin" --server "$sock" --remote-expr "$1"; }

alive() { [ -S "$sock" ] && [ "$(rexpr 1 2>/dev/null)" = 1 ]; }

# Call VoiceVimSpike.<fn>(arg) on the server, loading note.lua if needed.
call() { # fn [arg]
  rexpr "luaeval('(_G.VoiceVimSpike or dofile(_A[1])).$1(_A[2])', [$(vimstr "$here/note.lua"), $(vimstr "${2:-}")])"
}

ensure() {
  if alive; then
    echo "vv-host: running on $sock"
  else
    rm -f "$sock"
    # shellcheck disable=SC2086 # VV_HOST_NVIM_FLAGS is split on purpose.
    nohup "$nvim_bin" --headless --listen "$sock" ${VV_HOST_NVIM_FLAGS:-} \
      </dev/null >/dev/null 2>&1 &
    local i
    for i in $(seq 100); do alive && break; sleep 0.05; done
    alive || { echo "vv-host: server did not start on $sock" >&2; return 1; }
    echo "vv-host: started on $sock"
  fi
  # Load note.lua now, so the first `new` is not slowed by it.
  rexpr "luaeval('_G.VoiceVimSpike ~= nil or dofile(_A) ~= nil', $(vimstr "$here/note.lua"))" >/dev/null
}

stop() {
  if alive; then
    call stop >/dev/null
    local i
    for i in $(seq 100); do [ -e "$sock" ] || break; sleep 0.05; done
  fi
  rm -f "$sock"
}

case ${1:-} in
  ensure)     ensure ;;
  new)        call new "$notes" && echo ;;
  draft)      call draft && echo ;;
  attach-cmd) printf '%q --server %q --remote-ui\n' "$nvim_bin" "$sock" ;;
  stop)       stop ;;
  *) sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2; exit 2 ;;
esac
