{
  "title": "ferry: Hyper key and Hyper+V",
  "rules": [
    {
      "description": "Right Command held acts as Hyper (Cmd+Ctrl+Opt+Shift); tapped alone it stays Right Command",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "right_command",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": ["left_command", "left_control", "left_option"]
            }
          ],
          "to_if_alone": [{ "key_code": "right_command" }]
        }
      ]
    },
    {
      "description": "Hyper+V shows or hides ferry (hammerspoon://ferry-start)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "v",
            "modifiers": {
              "mandatory": ["command", "control", "option", "shift"]
            }
          },
          "to": [
            { "shell_command": "open -g 'hammerspoon://ferry-start'" }
          ]
        }
      ]
    }
  ]
}
